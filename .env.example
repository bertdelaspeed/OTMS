# ============================================================================
# ROLLCALL ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this file to .env.local and fill in your credentials
# All variables prefixed with VITE_ are exposed to the client-side app
# Variables without VITE_ prefix are server-side only (for the bridge)
# ============================================================================

# ============================================================================
# DATABASE BACKEND SELECTION
# ============================================================================
# Choose which backend to use: local | bridge | supabase | firebase
# Default: local
VITE_DB_KIND=local

# ============================================================================
# LOCAL BRIDGE (PostgreSQL/MySQL) - Server-side only
# ============================================================================
# These are used by the bridge server (server/bridge.mjs)
# Not exposed to the client for security

ROLLCALL_DB_ENGINE=postgres
ROLLCALL_DB_HOST=127.0.0.1
ROLLCALL_DB_PORT=5432
ROLLCALL_DB_NAME=rollcall
ROLLCALL_DB_USER=postgres
ROLLCALL_DB_PASSWORD=

# Bridge server configuration
ROLLCALL_BRIDGE_PORT=8787
ROLLCALL_BIND=127.0.0.1

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these from your Supabase project settings:
# Project URL: Settings > API > Project URL
# Anon Key: Settings > API > Project API keys > anon public

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================================
# FIREBASE CONFIGURATION
# ============================================================================
# Get this from Firebase Console:
# Realtime Database > Database URL

VITE_FIREBASE_URL=

# ============================================================================
# GOOGLE CALENDAR INTEGRATION
# ============================================================================
# Get this from Google Cloud Console:
# APIs & Services > Credentials > OAuth 2.0 Client IDs > Client ID

VITE_GOOGLE_CLIENT_ID=

# ============================================================================
# AUTO-SYNC SETTINGS
# ============================================================================
# Enable automatic sync to remote backend (when kind != local)
# Default: true
VITE_AUTO_SYNC=true
